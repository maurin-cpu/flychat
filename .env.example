OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=true
PORT=5000
INSTANTDB_ADMIN_TOKEN=your-admin-token-here

# Open-Meteo Customer API Key (optional). Wenn gesetzt, wird automatisch
# customer-api.open-meteo.com mit höheren Rate Limits genutzt.
OPENMETEO_API_KEY=

# Supabase (Postgres + Realtime)
# Dashboard → Settings → Database → Connection string (URI, Transaction Pooler, Port 6543)
SUPABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
