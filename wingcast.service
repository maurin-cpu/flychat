[Unit]
Description=Wingcast Flask App
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/flychat
EnvironmentFile=/home/deploy/flychat/.env
Environment="FLASK_DEBUG=false"
ExecStart=/home/deploy/flychat/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
ExecStartPre=/bin/sed -i 's/\r$//' /home/deploy/flychat/.env

[Install]
WantedBy=multi-user.target