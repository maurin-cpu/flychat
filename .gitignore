.env
__pycache__/
*.pyc
.venv/
venv/
.vercel
.claude/
nul

# Runtime SQLite (persistiert nur auf Server, nie im Repo)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs
*.log

# Node deps (nur fuer lokale Playwright-Debug-Screenshots)
node_modules/

# Runtime data (generated, server-local)
data/wetterdaten.json
data/synoptic_grid.json
# Zustand des Archiv-Waechters (Wiederholungssperre + Nachhol-Vermerk).
# Bewusst NICHT versioniert, anders als beim Frontenalarm: der bleibt in git,
# weil die Cloud-Routine keinen bleibenden Datentraeger hat. Der Waechter
# laeuft nur auf dem Server, dort ueberlebt die Datei den Neustart — im Repo
# wuerde sie zwischen Server und Arbeitsplatz hin und her springen.
data/.snapshot_wache.json

# Remotion-Video Export (generierte Tages-Vorhersage, kein Quellcode)
forecast_*_remotion.json
data/spot_analyses.json
data/region_analyses.json
data/weekly_briefing.json
data/history/
weather_context_dump.txt
data/preview/
data/mocks/wetterdaten.json
data/mocks/_meta.json
data/test_runs/
data/cost_telemetry.jsonl

# Few-Shot-Pipeline runtime artifacts (labels selbst werden gepusht)
data/labeled_examples.jsonl.lock
data/labeled_examples.jsonl.tmp
data/labeled_examples.jsonl.*.bak
data/labeled_examples.*.jsonl

# Runtime config (Admin-UI written, server-local)
data/config_overrides.json
data/test_mode.json

# Föhn-Test Wegwerf-Caches (debug_scripts/build_foehn_cache.py)
data/foehn_cache_*.json

# Lokale Dev-Server-Adresse fuer scripts/sync_from_server.sh
.dev_server

# Vorher/Nachher-Preview der Synoptik-Zonen (scripts/preview_synoptik_zonen.py)
data/_preview_synoptik_zonen.json

# Rohdaten + Plots des Fronten-Machbarkeitstests (scripts/experiment_fronten_tfp.py)
data/_experiment_fronten/

# Auto-Sicherung vor dem Anhaengen (scripts/build_observations_from_strong.py)
validation/xcontest/*.bak_before_auto

# Frontenkarten-Archiv (scripts/archive_dwd_fronten.py): Laufzeitdaten des
# Servers, behandelt wie data/wetterdaten.json — der Hetzner-Server sammelt
# 4x taeglich, nichts davon wird gepusht, geholt wird per
# scripts/sync_from_server.ps1. Vorher lag das im Git, weil der Cloud-Lauf
# keinen bleibenden Datentraeger hatte; der Server hat einen.
# deploy.sh stasht seit 03.08.2026 NUR getrackte Aenderungen — ignorierte
# UND untrackte Daten bleiben liegen. (Vorher stashte er mit
# --include-untracked: ignorierte Dateien wie dieses Archiv ueberlebten,
# aber untrackte Snapshots in data/weather_archive/ verschwanden in nie
# gepoppte Stashes.)
data/dwd_fronten_archiv/

# Maschinenausgabe der Fronten-Validierung. Von Hand gepflegt und damit
# versioniert bleiben nur README/SCHEMA/PATTERNS, die Fallstudien — und
# handurteile.csv, das der Validator ueber die Maschinenzeilen legt.
validation/fronten/observations.csv
validation/fronten/AUTO_REPORT.md
validation/fronten/aussagen/

# Maschinenausgabe der Gewitter-Validierung: schreibt der Server taeglich
# (scheduler -> scripts/validate_gewitter_daily.py). Gleiche Politik wie bei
# den Fronten — versioniert bleiben README/SCHEMA/PATTERNS, geholt wird per
# scripts/sync_from_server.ps1. Rekonstruierbar aus data/weather_archive/
# (Freeze, getrackt) + MeteoSchweiz-OGD-Archiv (amtlich, dauerhaft).
validation/gewitter/messwerte/
validation/gewitter/urteile/
validation/gewitter/scoreboard.json
validation/gewitter/AUTO_REPORT.md

# MeteoSchweiz-Stationsmessungen (Validierungs-Cache, server-lokal)
data/_meteoschweiz_cache/

# Sicherungen der Regionen-Umbenennung 2026-08 (scripts/migrate_region_names.py)
*.pre_rename
